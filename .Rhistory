cellpenalty <-
raster::calc(mymap, fun = function(r) { r[!is.na(r)] <- 1 ; r[is.na(r)] <- obspenalty; return(r) })
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
