ymin = UK9004171_bysea$metadata[["y_min"]],
ymax = UK9004171_bysea$metadata[["y_max"]],
crs = UK9004171_bysea$metadata[["crs"]]
)
#fill it with the data
terra::values(fltdist_base_example) <- UK9004171_bysea$matrix
fltdist_base_example_repr <- terra::project(fltdist_base_example,
terra::crs(uk_map))
fltdist_base_df <- as.data.frame(fltdist_base_example_repr, xy = TRUE)
ggplot2::ggplot() +
# Plot the raster
ggplot2:: geom_raster(data = fltdist_base_df, ggplot2::aes(x = x, y = y, fill = ifelse(lyr.1 == 0, NA, lyr.1))) +
# Add the reprojected UK boundary
ggplot2::geom_sf(data = uk_map, fill = NA, color = "#D63333", size = 1.5) +
# Customize the plot
theme_bslib +  #palette theme
ggplot2::scale_fill_viridis_c(
na.value = "gray",  # Set the color for NA (i.e., for 0 values)
name = "fltdist_base Data", direction = -1) +
ggplot2::labs(fill = "fltdist_base Raster Value",
title = "Raster and outline of the UK (red)",
caption = "Example 1: data fltdist_base")
