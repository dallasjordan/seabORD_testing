FlightGridcorrection <- seabORD::FlightGridcorrection_3035
# to plot it you have to extract the values back into a raster):
# get the Transition Matrix
transition_matrix <- gdistance::transitionMatrix(FlightGridcorrection)
#non_zero_count <- Matrix::nnzero(transition_matrix)
# extract the diagonal values
#diag_vals <- Matrix::diag(transition_matrix)
#Sum each row to calculate total connectivity for each cell
total_connectivity <- Matrix::rowSums(transition_matrix)
#Create a Raster for the total_connectivity
total_connectivity_raster <- terra::rast(
nrows = nrow(FlightGridcorrection),
ncols = ncol(FlightGridcorrection),
xmin = raster::extent(FlightGridcorrection)[1],
xmax = raster::extent(FlightGridcorrection)[2],
ymin = raster::extent(FlightGridcorrection)[3],
ymax = raster::extent(FlightGridcorrection)[4],
crs = "+proj=laea +lat_0=52 +lon_0=10 +x_0=4321000 +y_0=3210000 +ellps=GRS80 +units=m +no_defs",
vals = total_connectivity #assign values
)
#uk
uk_map <- dplyr::select(
rnaturalearth::ne_countries(country = "United Kingdom",
scale = "medium",
returnclass = "sf"),
name,
geometry)
#change crs
total_connectivity_raster <- terra::project(total_connectivity_raster,
terra::crs(uk_map))
#plot
raster_df <- as.data.frame(total_connectivity_raster, xy = TRUE)
ggplot2::ggplot() +
# Plot the raster layer using geom_raster
ggplot2::geom_raster(data = raster_df, ggplot2::aes(x = x, y = y, fill = lyr.1)) +
# Add the UK boundary using geom_sf
ggplot2::geom_sf(data = uk_map, fill = NA, color = "red", size = 1.5) +
# Customize the plot appearance
ggplot2::theme_minimal() +
ggplot2::scale_fill_viridis_c(name = "Connectivity Value") +
ggplot2::labs(title = "Total Connectivity Raster with UK Boundary")
#plot
total_connectivity_df <- as.data.frame(total_connectivity_raster, xy = TRUE)
ggplot2::ggplot() +
# Plot the raster
ggplot2:: geom_raster(data = total_connectivity_df, ggplot2::aes(x = x, y = y, fill = ifelse(lyr.1 == 0, NA, lyr.1))) +
# Add the reprojected UK boundary
ggplot2::geom_sf(data = uk_map, fill = NA, color = "#D63333", size = 1.5) +
# Customize the plot
theme_bslib +  #palette theme
ggplot2::scale_fill_viridis_c(
na.value = "gray",  # Set the color for NA (i.e., for 0 values)
name = "total_connectivity_df Data", direction = -1) +
ggplot2::labs(fill = "total_connectivity_df Raster Value",
title = "Raster and outline of the UK (red)",
caption = "Example 1: data total_connectivity_df")
ORDpoly_example <- seabORD::ORDpoly_example
ORDpoly_example <- seabORD::ORDpoly_example
ORDpoly_example_repr <- ORDpoly_example %>%
sf::st_transform(sf::st_crs(uk_map))
ggplot2::ggplot() +
# Plot the reprojected UK map in red
ggplot2::geom_sf(data = data = uk_map, fill = NA, color = "#D63333", size = 1.5) +
ORDpoly_example_repr <- ORDpoly_example %>%
sf::st_transform(sf::st_crs(uk_map))
ggplot2::ggplot() +
# Plot the reprojected UK map in red
ggplot2::geom_sf(data = data = uk_map, fill = NA, color = "#D63333", size = 1.5) +
ggplot2::ggplot() +
# Plot the reprojected UK map in red
ggplot2::geom_sf(data =  uk_map, fill = NA, color = "#D63333", size = 1.5) +
# Add the ORDpoly_example shapes with a different color
ggplot2::geom_sf(data = ORDpoly_example_repr, fill = "#0483A4", color = "#0483A4", size = 1) +
ggplot2::coord_sf(xlim = c(-4, 1), ylim = c(55, 57)) +
# Customize the plot appearance
ggplot2::theme_minimal() +
ggplot2::labs(title = "UK Map (red) and ORDpoly Shapes (blue)")
ggplot2::ggplot() +
# Plot the reprojected UK map in red
ggplot2::geom_sf(data =  uk_map, fill = NA, color = "#D63333", size = 1.5) +
# Add the ORDpoly_example shapes with a different color
ggplot2::geom_sf(data = ORDpoly_example_repr, fill = "#0483A4", color = "#0483A4", size = 1) +
ggplot2::coord_sf(xlim = c(-4, 1), ylim = c(55, 57)) +
theme_bslib +  #palette theme
ggplot2::labs(title = "UK Map (red) and ORDpoly Shapes (blue)")
