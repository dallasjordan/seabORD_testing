calc_adultbmchange <- function(alive, BM_adult, Egain_adult, Ereq_adult,
adult_mass_KG){
if (alive){
BM_adult <- BM_adult + ((Egain_adult - Ereq_adult)/adult_mass_KG)
}
return(BM_adult)
}
